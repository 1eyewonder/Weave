source https://api.nuget.org/v3/index.json
storage: none

nuget FSharp.Core
nuget FsToolkit.ErrorHandling
nuget WebSharper
nuget WebSharper.UI
nuget WebSharper.FSharp
nuget WebSharper.AspNetCore

group test
  source https://api.nuget.org/v3/index.json
  storage: none

  nuget FSharp.Core 10.1.403 // setup to match Main to prevent build warnings
  nuget Expecto.FsCheck
  nuget Microsoft.NET.Test.Sdk
  nuget YoloDev.Expecto.TestSdk
  nuget Microsoft.Playwright
  nuget Microsoft.Playwright.Xunit
  nuget Deque.AxeCore.Playwright
  nuget xunit
  nuget xunit.v3.core
  nuget xunit.v3.assert
  nuget xunit.runner.visualstudio
  nuget OpenTelemetry.Api >= 1.15.3 // https://github.com/advisories/GHSA-g94r-2vxg-569j

group analyzers
  source https://api.nuget.org/v3/index.json

  nuget Ionide.Analyzers
  nuget G-Research.FSharp.Analyzers

group build
  source https://api.nuget.org/v3/index.json
  storage: none

  nuget Fake.Core.Target
  nuget Fake.Core.ReleaseNotes
  nuget Fake.DotNet.AssemblyInfoFile
  nuget Fake.DotNet.Paket
  nuget Fake.Tools.Git
  nuget Fake.Api.GitHub
  nuget Fake.BuildServer.GitHubActions
  nuget Fake.Javascript.Yarn
  nuget NuGet.Packaging >= 7.3.1 // https://github.com/advisories/GHSA-g4vj-cjjj-v7hg
  nuget NuGet.Protocol >= 7.3.1 // https://github.com/advisories/GHSA-g4vj-cjjj-v7hg
  nuget System.Security.Cryptography.Pkcs >= 10.0.13 // https://github.com/advisories/GHSA-2fmv-rv2c-59x7 https://github.com/advisories/GHSA-846f-f764-76mx
