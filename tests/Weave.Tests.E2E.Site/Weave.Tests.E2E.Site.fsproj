  <ItemGroup>
    <ProjectReference Include="../../src/Weave/Weave.fsproj" />
    <Content Remove="wwwroot/Scripts/docs.css" />
    <Content Remove="wwwroot/Scripts/code-highlighting.css" />
    <Content Remove="wwwroot/Scripts/weave-highlight.min.js" />
    <Content Include="../../src/Weave.Docs/wwwroot/code-highlighting.css" Link="wwwroot/Scripts/code-highlighting.css" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../src/Weave.Docs/wwwroot/vendor/highlightjs/weave-highlight.min.js" Link="wwwroot/Scripts/weave-highlight.min.js" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../src/Weave.Docs/wwwroot/docs.css" Link="wwwroot/Scripts/docs.css" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="BuildCodeHighlighting" BeforeTargets="BeforeBuild">
    <Exec Command="node build-highlighting.mjs" WorkingDirectory="$(ProjectDir)../../src/Weave.Docs" />
  </Target>
  <Target Name="CopyWeaveStyles" BeforeTargets="Build">
    <Copy SourceFiles="../../src/Weave/styles.css" DestinationFolder="$(ProjectDir)wwwroot/Scripts" SkipUnchangedFiles="true" />
    <Copy SourceFiles="../../src/Weave.Docs/wwwroot/docs.css" DestinationFolder="$(ProjectDir)wwwroot/Scripts" SkipUnchangedFiles="true" />
    <Copy SourceFiles="../../src/Weave.Docs/wwwroot/code-highlighting.css" DestinationFolder="$(ProjectDir)wwwroot/Scripts" SkipUnchangedFiles="true" />
    <Copy SourceFiles="../../src/Weave.Docs/wwwroot/vendor/highlightjs/weave-highlight.min.js" DestinationFolder="$(ProjectDir)wwwroot/Scripts" SkipUnchangedFiles="true" />
  </Target>
  <Import Project="..\..\.paket\Paket.Restore.targets" />
</Project>
