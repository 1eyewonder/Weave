{
  "name": "weave",
  "version": "1.0.0",
  "private": true,
  "packageManager": "yarn@4.5.3",
  "scripts": {
    "test:docs:snippets": "dotnet fsi tests/Weave.Docs.Snippets/check.fsx",
    "test:docs:highlighting": "yarn build:docs:highlighting && node --test tests/Weave.Docs.Highlighting/highlighting.test.mjs",
    "build:docs:highlighting": "node src/Weave.Docs/build-highlighting.mjs",
    "build:css": "yarn sass src/Weave/scss/main.scss:src/Weave/styles.css --no-source-map",
    "watch:css": "yarn sass --watch src/Weave/scss/main.scss:src/Weave/styles.css --no-source-map",
    "watch:docs:css": "yarn watch:css & yarn sass --watch src/Weave/scss/main.scss:src/Weave.Docs/wwwroot/Scripts/styles.css --no-source-map",
    "dev:docs:vite": "vite --config src/Weave.Docs/vite.config.mjs",
    "dev:docs": "yarn build:css && dotnet build src/Weave.Docs/Weave.Docs.fsproj && concurrently --kill-others --names library-css,docs-css,dotnet,vite \"yarn watch:css\" \"yarn sass --watch src/Weave/scss/main.scss:src/Weave.Docs/wwwroot/Scripts/styles.css --no-source-map\" \"cd src/Weave.Docs && dotnet watch build\" \"yarn dev:docs:vite\""
  },
  "devDependencies": {
    "concurrently": "^10.0.7",
    "esbuild": "^0.27.3",
    "highlight.js": "11.11.1",
    "jsdom": "26.1.0",
    "sass": "^1.96.0",
    "vite": "^8"
  }
}
